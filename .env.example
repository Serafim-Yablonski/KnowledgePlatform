# Copy this file to .env and fill in your values before running `make run`.
# Never commit .env — it is in .gitignore.

# ─── Database ─────────────────────────────────────────────────────────────────
# Full async SQLAlchemy / asyncpg connection URL used by the application.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/knowledge_platform

# PostgreSQL credentials consumed by the postgres Docker service.
POSTGRES_DB=knowledge_platform
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# ─── Redis ────────────────────────────────────────────────────────────────────
# The cache, rate limiter and research stream. It holds no work (ADR-027): compose
# runs it without persistence.
REDIS_URL=redis://localhost:6379/0

# ─── Pipeline workers (ADR-027) ───────────────────────────────────────────────
# Optional; the defaults suit a laptop. Leave a line commented rather than empty:
# every process reads .env, and an empty value is not a number (startup fails).
# Attempts at once per worker process (production: 4 and 10).
# PIPELINE_EXTRACT_CONCURRENCY=2
# PIPELINE_EMBED_CONCURRENCY=2
# The extract worker's memory cap (compose only). Sized for 2 slots at the 25 MB
# upload cap; raise it with PIPELINE_EXTRACT_CONCURRENCY (tests/unit/test_compose.py).
# PIPELINE_EXTRACT_MEM_LIMIT=1536m

# ─── Security / JWT ───────────────────────────────────────────────────────────
# MUST be replaced with `openssl rand -hex 32` output before going to production.
SECRET_KEY=replace-me-with-openssl-rand-hex-32

# JWT signing algorithm — HS256 is fine for single-tenant; switch to RS256 for multi-issuer.
JWT_ALGORITHM=HS256

# Token lifetime in minutes.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─── Provider API Keys ────────────────────────────────────────────────────────
# PydanticAI reads these directly from the environment based on the model string.
# google-gla:* reads GOOGLE_API_KEY; anthropic:* reads ANTHROPIC_API_KEY.
GOOGLE_API_KEY=AIza...
ANTHROPIC_API_KEY=sk-ant-...

# ─── LLM — used by PydanticAI agents (change to any supported provider:model) ─
LLM_MODEL=google-gla:gemini-3.5-flash-lite
LLM_STRONG_MODEL=google-gla:gemini-3.8-flash

# ─── Embeddings ───────────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=gemini-embedding-001
# Optional: a separate key for embeddings; empty means GOOGLE_API_KEY.
EMBEDDING_API_KEY=
# Vector dimensions MUST match the pgvector column (Vector(settings.EMBEDDING_DIMENSIONS)).
# Changing the model or dimensions requires re-embedding all documents (no re-index command yet).
EMBEDDING_DIMENSIONS=768

# ─── Observability ────────────────────────────────────────────────────────────
# Pydantic Logfire write token — obtain from logfire.pydantic.dev.
# Leave blank to disable Logfire; OTel traces still emit to stdout in dev.
LOGFIRE_TOKEN=

# ─── Application ──────────────────────────────────────────────────────────────
# Deployment environment: development | staging | production
ENVIRONMENT=development

# ─── File Uploads ─────────────────────────────────────────────────────────────
# Absolute path where uploaded files are stored inside the container.
UPLOAD_DIR=/data/uploads

# Maximum permitted upload size in megabytes.
MAX_UPLOAD_SIZE_MB=25

# ─── MCP Server ───────────────────────────────────────────────────────────────
# MCP clients (developer tools and code agents) authenticate with database-backed
# API keys sent as `Authorization: Bearer <key>`. Run `make mcp-config` to create
# a key and print how to connect a client. No env vars are needed.
