# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
wheels/
.eggs/

# ─── Virtual environments ─────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ─── Environment variables — NEVER commit secrets ─────────────────────────────
.env

# ─── Data / uploads ───────────────────────────────────────────────────────────
/data/

# ─── Test & lint caches ───────────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml
*.cover

# ─── Evaluation results ───────────────────────────────────────────────────────
# Ignore run results; keep baseline tracked for regression comparisons.
results/*.json
!results/baseline.json

# ─── IDE ──────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ─── macOS ────────────────────────────────────────────────────────────────────
.DS_Store

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
